      (effects (font (size 1.6 1.6)) (justify left)) (uuid "8b0c8f13-34bb-5625-b82f-d94b7ab55d61") )
  (text "For 1st-gen DCC Advanced Rev B 1.0 only. Not a production-qualified automotive design." (exclude_from_sim no) (at 20.00 25.00 0)
      (effects (font (size 1.15 1.15)) (justify left)) (uuid "2dea5e91-5c9f-5cc8-99a3-0079c6bc526f") )
  (text "JP1 installed: adds 120 ohm termination. Leave open when tapping an already terminated bus." (exclude_from_sim no) (at 20.00 32.00 0)
      (effects (font (size 1.15 1.15)) (justify left)) (uuid "a8ca4ba3-6d55-593d-946d-fcb235f4df80") )
  (text "J2 pin 1 = EXP_IO1 / GPIO18 / CAN RX; pin 2 = EXP_IO2 / GPIO15 / listen-only TX idle; pin 3 = NC; pin 4 = EXP_GND." (exclude_from_sim no) (at 20.00 145.00 0)
      (effects (font (size 1.15 1.15)) (justify left)) (uuid "3408a205-9985-52b4-beb9-212c205502c1") )
  (text "Simple 12 V input only: no reverse-polarity, load-dump, surge, fuse, or isolation protection is included." (exclude_from_sim no) (at 20.00 152.00 0)
